<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagamento</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/reajuste">Reajuste</a></li>
            <li><a href="/imc">IMC</a></li>
            <li><a href="/aluno">Aluno</a></li>
            <li><a href="/pagamento">Pagamento</a></li>
            
        </ul>
    </nav>

    <div class="container1">
        <h1 class="rjtitle">Cálculo de Pagamento:</h1>

        <form action="/pagamento" method="GET">
            <input type="number" name="valor" placeholder="Insira o valor da compra" min="0" step="0.01" required>

            <select name="opcao" required style="display: block; margin: 20px auto; padding: 10px; width: 220px; border-radius: 5px; border-color: #e95133db; background-color: transparent; color: #A2A2A2;">
                <option value="">Forma de pagamento</option>
                <option value="1">À vista (Dinheiro ou Pix) 15% de Desconto</option>
                <option value="2">À vista (Cartão) 10% de Desconto</option>
                <option value="3">Parcelado</option>
            </select>

            <button class="calcular" type="submit">Calcular</button>
        </form>

        <p class="resultado">Valor final da compra: R$ <%= valorfinal %></p>

        <button class="novamente">
            <a href="/pagamento">Calcular novamente</a>
        </button>
    </div>

</body>
</html>